<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/beacon_surface" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="114dp"
        android:background="@color/beacon_navy" android:gravity="center_vertical"
        android:padding="20dp" android:orientation="horizontal">
        <ImageView android:layout_width="62dp" android:layout_height="84dp"
            android:contentDescription="Beacon logo" android:src="@drawable/beacon_mark"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Beacon" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Your people" android:textColor="#65C7FF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:padding="18dp"
        android:background="@drawable/beacon_card" android:orientation="vertical">
        <TextView android:id="@+id/beaconProfileName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Your profile"
            android:textColor="@color/beacon_text" android:textSize="21sp" android:textStyle="bold"/>
        <TextView android:id="@+id/beaconProfileStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Available"
            android:textColor="@color/beacon_green" android:textSize="13sp"/>
        <RadioGroup android:id="@+id/beaconPresence" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <RadioButton style="@style/BeaconStatusChip" android:id="@+id/presenceOnline" android:layout_width="0dp"
                android:layout_height="44dp" android:text="Online" android:checked="true"/>
            <RadioButton style="@style/BeaconStatusChip" android:id="@+id/presenceAway" android:layout_width="0dp"
                android:layout_height="44dp" android:text="Away"/>
            <RadioButton style="@style/BeaconStatusChip" android:id="@+id/presenceBusy" android:layout_width="0dp"
                android:layout_height="44dp" android:text="Busy"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:orientation="horizontal">
        <EditText android:id="@+id/beaconBuddySearch" style="@style/BeaconInput"
            android:layout_width="0dp" android:layout_weight="1"
            android:hint="Search people..." android:inputType="text"/>
        <Button android:id="@+id/beaconAddBuddy" style="@style/BeaconPrimaryButton"
            android:layout_width="122dp" android:layout_marginLeft="8dp" android:text="+ Add buddy"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingLeft="20dp" android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp" android:text="YOUR PEOPLE"
        style="@style/BeaconSectionLabel" android:textColor="@color/beacon_blue"/>
    <ListView android:id="@+id/beaconBuddyList" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent"
        android:dividerHeight="6dp" android:paddingLeft="16dp" android:paddingRight="16dp"
        android:clipToPadding="false"/>
    <TextView android:id="@+id/beaconRosterFooter" android:layout_width="match_parent"
        android:layout_height="44dp" android:gravity="center_vertical" android:paddingLeft="20dp"
        android:text="CONNECTED TO YOUR SERVER" android:textSize="11sp"
        android:textColor="@color/beacon_muted"/>
</LinearLayout>
