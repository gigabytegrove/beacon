<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/beacon_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="116dp"
        android:orientation="vertical" android:padding="20dp" android:background="@color/beacon_navy">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BEACON  /  INSTANT MESSAGE" android:textColor="#65C7FF" android:textStyle="bold" android:textSize="11sp"/>
        <TextView android:id="@+id/beaconChatName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Conversation"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp"/>
        <TextView android:id="@+id/beaconChatPresence" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Online" android:textColor="#62D8AB" android:textSize="12sp"/>
    </LinearLayout>
    <ListView android:id="@+id/beaconMessages" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:layout_margin="12dp" android:background="@drawable/beacon_card"
        android:padding="12dp" android:clipToPadding="false"
        android:divider="@android:color/transparent" android:dividerHeight="5dp"/>
    <TextView android:id="@+id/beaconTyping" android:layout_width="match_parent"
        android:layout_height="30dp" android:paddingLeft="22dp"
        android:textColor="@color/beacon_green" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:padding="12dp"
        android:orientation="horizontal" android:background="@drawable/beacon_card">
        <EditText android:id="@+id/beaconComposer" style="@style/BeaconInput"
            android:layout_width="0dp" android:layout_weight="1"
            android:inputType="textMultiLine|textCapSentences" android:singleLine="false"
            android:maxLines="4" android:hint="Write a message..."/>
        <Button android:id="@+id/beaconSend" style="@style/BeaconPrimaryButton"
            android:layout_width="100dp" android:layout_marginLeft="10dp" android:text="Send IM"/>
    </LinearLayout>
</LinearLayout>
