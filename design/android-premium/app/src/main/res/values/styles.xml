<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BeaconTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/beacon_blue</item>
        <item name="android:statusBarColor">@color/beacon_navy</item>
        <item name="android:navigationBarColor">@color/beacon_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/beacon_surface</item>
    </style>
    <style name="BeaconSectionLabel">
        <item name="android:textColor">@color/beacon_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="BeaconPrimaryButton">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/beacon_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="BeaconInput">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/beacon_field</item>
        <item name="android:textColor">@color/beacon_text</item>
        <item name="android:textColorHint">@color/beacon_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>
    <style name="BeaconStatusChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/beacon_status_chip</item>
        <item name="android:textColor">@color/beacon_status_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BeaconBuddyTitle">
        <item name="android:textColor">@color/beacon_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
